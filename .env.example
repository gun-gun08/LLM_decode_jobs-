# LLM Decode - LOCAL Odoo instance settings. Copy to .env (scripts\setup.ps1 does this for you and replaces the "change-me" passwords
# with random local-only values). .env is git-ignored: never commit it, never paste it in a chat, never put a production password or the
# live site's MCP key here.
#
# To keep using the database you already have, do NOT create a new .env: copy your existing local_odoo\.env to this folder instead
# (the PostgreSQL password is fixed when its volume is first created; a new random one would lock you out of that database).

# ---- Docker / database --------------------------------------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me
ODOO_PORT=8070
ODOO_DB=llmd_local
# Optional: a second, separate instance next to the first one (own containers + volumes). Leave unset to use "llmd-local".
# COMPOSE_PROJECT_NAME=llmd-local-2

# ---- Odoo login used by the setup seed and the test tools (XML-RPC) -----------------------------------------------------------
ODOO_USER=admin
ODOO_PASSWORD=change-me

# ---- Job sources (all optional) -----------------------------------------------------------------------------------------------
# The default source "Company job boards" (Greenhouse, Lever, Ashby, SmartRecruiters public APIs) needs NO key.
# Empty = that source is "not connected" (never shown as working). With direct links only (the default) Adzuna and Jooble are switched off anyway,
# because their links open their own pages first.
# Adzuna: free key at https://developer.adzuna.com/ (app id + app key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: key from https://jooble.org/api/about
JOOBLE_API_KEY=
# JSearch: RapidAPI key (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch), or an OpenWebNinja key together with
# JSEARCH_BASE_URL=https://api.openwebninja.com/jsearch/search
JSEARCH_API_KEY=
JSEARCH_BASE_URL=

# Official partner job feeds - only if Indeed / Naukri have given you one (they have no public self-serve job-search API)
INDEED_FEED_URL=
INDEED_FEED_TOKEN=
NAUKRI_FEED_URL=
NAUKRI_FEED_TOKEN=

# ---- Applicant API -------------------------------------------------------------------------------------------------------------
# Key of POST /api/llmd/applications (header X-Api-Key): the only way applicant data from an authorized provider / ATS enters Odoo.
# Empty = the API is switched off. Apply Now clicks never need it and never carry applicant data.
LLMD_APPLICATION_API_KEY=
