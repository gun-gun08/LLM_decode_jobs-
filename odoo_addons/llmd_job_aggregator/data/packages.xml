<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- the two packages of the page for companies; created once, then the team changes them under Job board > Packages (an update never resets them) -->
    <data noupdate="1">
        <record id="package_bundle" model="llmd.hr.package">
            <field name="name">Bundle of 3</field>
            <field name="sequence">10</field>
            <field name="limit">3</field>
            <field name="post_limited">5</field>
            <field name="amount">1000</field>
            <field name="currency_id" ref="base.INR"/>
        </record>
        <record id="package_pack" model="llmd.hr.package">
            <field name="name">Hiring pack</field>
            <field name="sequence">20</field>
            <field name="limit">5</field>
            <field name="post_limited">5</field>
            <field name="amount">5000</field>
            <field name="currency_id" ref="base.INR"/>
        </record>
    </data>
</odoo>
